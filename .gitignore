# Self-Storage Market Tracker — .gitignore

# Environment & secrets
.env
*.env

# Database
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Logs
*.log
collector.log

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Playwright browsers (large, download fresh)
playwright_browsers/

# Node / React
node_modules/
frontend/node_modules/
frontend/dist/
.scraper_status
.scraper_pid
debug_screenshots/

# Scraped data stays out of git: lead CSVs contain homeowner names/emails/phones and the repo is public.
# (Only data/storage_prices/ - public competitor prices - is committed on purpose.)
data/imports/
data/raw/
*.csv
!data/storage_prices/*.csv
